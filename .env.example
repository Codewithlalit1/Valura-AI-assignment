# =============================================================================
# Valura AI — Team Lead Assignment — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values you need.
# Never commit your .env file.

# --- LLM provider (set ONE of the two keys below) ---
# Priority: OPENAI_API_KEY > GOOGLE_API_KEY
# If both are set, OpenAI is used. If neither is set, the server starts
# but every LLM call will fail with an authentication error.

# Option A — OpenAI
OPENAI_API_KEY=sk-...
MODEL_DEV=gpt-4o-mini        # model for local development
MODEL_EVAL=gpt-4.1           # model used during evaluation / grading

# Option B — Google Gemini (leave OPENAI_API_KEY blank or remove it)
GOOGLE_API_KEY=AIza...
GEMINI_MODEL_DEV=gemini-2.0-flash    # model for local development
GEMINI_MODEL_EVAL=gemini-1.5-pro     # model used during evaluation / grading

# --- Session persistence ---
# memory | sqlite | postgres
SESSION_STORE=memory

# --- Application ---
APP_ENV=development              # development | production | test

# =============================================================================
# Optional — only set what you actually use
# =============================================================================

# --- Persistence (your choice) ---
# Sessions can be persisted to Postgres, SQLite, or kept in-memory for the
# assignment. Set this only if you choose Postgres / a real DB.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# --- Pre-classifier vector DB ---
# Only if you implement the optional embedding-based pre-classifier (stretch).
PGVECTOR_DATABASE_URL=

# --- Cache backend ---
# Only if you implement the optional dedupe cache (stretch) and choose Redis.
# Leave blank to use in-memory caching.
REDIS_URL=
